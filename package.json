{
  "name": "cafeteria-sema-root",
  "version": "1.0.0",
  "scripts": {
    "build": "node -e \"if (require('fs').existsSync('frontend')) process.chdir('frontend'); require('child_process').execSync('npm run build', {stdio: 'inherit'});\"",
    "start:frontend": "cd frontend && npm run dev",
    "dev": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
